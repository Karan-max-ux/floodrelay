# Database (used by infra/docker-compose.yml and the backend service)
POSTGRES_USER=floodrelay
POSTGRES_PASSWORD=floodrelay_dev
POSTGRES_DB=floodrelay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string (convenience, built from the values above)
DATABASE_URL=postgresql://floodrelay:floodrelay_dev@localhost:5432/floodrelay
