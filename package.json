{
  "name": "floodrelay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && vitest run tests/load tools/demo --fileParallelism=false",
    "test:repair-integration": "npm --workspace=@floodrelay/api run test:repair-integration",
    "test:demo-integration": "npm --workspace=@floodrelay/api run test:demo-integration",
    "provision:test-db": "npm --workspace=@floodrelay/api run provision:test-db",
    "evaluate": "vitest run packages/solver/src/evaluation/benchmark.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:load": "node tests/load/run.js",
    "test:load:smoke": "node tests/load/run.js -e LOAD_PROFILE=smoke",
    "test:load:baseline": "node tests/load/run.js -e LOAD_PROFILE=baseline",
    "test:load:stress": "node tests/load/run.js -e LOAD_PROFILE=stress",
    "demo:setup": "tsx tools/demo/setupDemo.ts",
    "demo:cleanup": "tsx tools/demo/cleanupDemo.ts",
    "demo:credentials": "tsx tools/demo/showCredentials.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    },
    "postcss": "^8.5.33"
  }
}
